@implementation PubgLoad

static BOOL MenDeal;
static PubgLoad *extraInfo;
static UIWindow *mainWindow;

+ (void)load {
    [super load];
    
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        @try {
            extraInfo = [PubgLoad new];
            [extraInfo autoLogin];
            [extraInfo KhanhTrinh];
        } @catch (NSException *exception) {
            NSLog(@"Error in load: %@", exception);
        }
    });
}

- (UIViewController *)topViewController:(UIViewController *)rootViewController {
    if ([rootViewController isKindOfClass:[UINavigationController class]]) {
        UINavigationController *nav = (UINavigationController *)rootViewController;
        return [self topViewController:nav.visibleViewController];
    }
    if ([rootViewController isKindOfClass:[UITabBarController class]]) {
        UITabBarController *tab = (UITabBarController *)rootViewController;
        return [self topViewController:tab.selectedViewController];
    }
    if (rootViewController.presentedViewController) {
        return [self topViewController:rootViewController.presentedViewController];
    }
    return rootViewController;
}

- (void)autoLogin {
    @try {
        NSString *savedKey = [APIHandler getSavedKey];
        if (savedKey.length > 0) {
            [APIHandler validateKey:savedKey completion:^(BOOL success, NSString * _Nullable message, NSString * _Nullable expiry) {
                @try {
                    if (success) {
                        NSLog(@"[Auto] Key valid → Expires: %@", expiry ?: @"N/A");
                        mainWindow = [UIApplication sharedApplication].keyWindow;
                        if (mainWindow) {
                            [self initTapGes];
                            [self initTapGes2];
                                [self setupDoxButton];
                        }
                    } else {
                        NSLog(@"[Auto] Invalid key: %@", message ?: @"no message");
                        [self showLoginAlert];
                    }
                } @catch (NSException *e) {
                    NSLog(@"Exception in autoLogin completion: %@", e);
                    [self showLoginAlert];
                }
            }];
        } else {
            [self showLoginAlert];
        }
    } @catch (NSException *e) {
        NSLog(@"Exception in autoLogin: %@", e);
        [self showLoginAlert];
    }
}

- (void)showLoginAlert {
    @try {
        UIAlertController *alert = [UIAlertController alertControllerWithTitle:@"Zoldik Login"
                                                                      message:@"Please enter your API Key"
                                                               preferredStyle:UIAlertControllerStyleAlert];
        
        [alert addTextFieldWithConfigurationHandler:^(UITextField *textField) {
            textField.placeholder = @"API Key";
            textField.secureTextEntry = YES;
        }];
        
        UIAlertAction *loginAction = [UIAlertAction actionWithTitle:@"Login"
                                                              style:UIAlertActionStyleDefault
                                                            handler:^(UIAlertAction *action) {
            @try {
                NSString *key = alert.textFields.firstObject.text ?: @"";
                if (key.length == 0) {
                    NSLog(@"Empty key entered");
                    return;
                }
                
                [APIHandler validateKey:key completion:^(BOOL success, NSString * _Nullable message, NSString * _Nullable expiry) {
                    @try {
                        if (success) {
                            NSLog(@"[Login] Success → Expires: %@", expiry ?: @"N/A");
                            
                            mainWindow = [UIApplication sharedApplication].keyWindow;
                            if (mainWindow) {
                                [self initTapGes];
                                [self initTapGes2];
                                [self setupDoxButton];
                            }
                            
                            NSString *displayMsg = [NSString stringWithFormat:@"%@\nExpires: %@", 
                                                    message ?: @"Key accepted", expiry ?: @"N/A"];
                            
                            UIAlertController *successAlert = [UIAlertController alertControllerWithTitle:@"Success"
                                                                                                  message:displayMsg
                                                                                           preferredStyle:UIAlertControllerStyleAlert];
                            [successAlert addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
                            
                            UIViewController *topVC = [self topViewController:[UIApplication sharedApplication].keyWindow.rootViewController];
                            if (topVC) [topVC presentViewController:successAlert animated:YES completion:nil];
                        } else {
                            UIAlertController *failAlert = [UIAlertController alertControllerWithTitle:@"Error"
                                                                                               message:message ?: @"Validation failed"
                                                                                        preferredStyle:UIAlertControllerStyleAlert];
                            [failAlert addAction:[UIAlertAction actionWithTitle:@"Retry"
                                                                          style:UIAlertActionStyleDefault
                                                                        handler:^(UIAlertAction * _Nonnull action) {
                                [self showLoginAlert];
                            }]];
                            
                            UIViewController *topVC = [self topViewController:[UIApplication sharedApplication].keyWindow.rootViewController];
                            if (topVC) [topVC presentViewController:failAlert animated:YES completion:nil];
                        }
                    } @catch (NSException *e) {
                        NSLog(@"Exception in validateKey completion: %@", e);
                    }
                }];
            } @catch (NSException *e) {
                NSLog(@"Exception in login action handler: %@", e);
            }
        }];
        
        [alert addAction:loginAction];
        
        UIViewController *topVC = [self topViewController:[UIApplication sharedApplication].keyWindow.rootViewController];
        if (topVC) {
            [topVC presentViewController:alert animated:YES completion:nil];
        }
    } @catch (NSException *e) {
        NSLog(@"Exception in showLoginAlert: %@", e);
    }
}

- (void)KhanhTrinh {
    @try {
        UIViewController *vc = [JHPP currentViewController];
        if (!vc || !vc.view) {
            NSLog(@"[KhanhTrinh] currentViewController or view is nil");
            return;
        }
        
        UIView *iconView = [vc.view viewWithTag:100];
        if (!iconView) {
            iconView = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 50, 50)];
            iconView.tag = 100;
            iconView.backgroundColor = [UIColor clearColor];
            [vc.view addSubview:iconView];

            UITapGestureRecognizer *singleTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(tapIconView)];
            singleTap.numberOfTapsRequired = 1;
            [iconView addGestureRecognizer:singleTap];

            UITapGestureRecognizer *doubleTap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(tapIconView2)];
            doubleTap.numberOfTapsRequired = 2;
            [iconView addGestureRecognizer:doubleTap];
            
            iconView.hidden = NO;
        }
    } @catch (NSException *e) {
        NSLog(@"Exception in KhanhTrinh: %@", e);
    }
}

- (void)initTapGes {
    UIView *target = [JHPP currentViewController].view;
    if (!target) return;
    
    UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(tapIconView)];
    tap.numberOfTapsRequired = 2;
    tap.numberOfTouchesRequired = 3;
    [target addGestureRecognizer:tap];
}

- (void)initTapGes2 {
    UIView *target = [JHPP currentViewController].view;
    if (!target) return;
    
    UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(tapIconView2)];
    tap.numberOfTapsRequired = 2;
    tap.numberOfTouchesRequired = 2;
    [target addGestureRecognizer:tap];
}

- (void)tapIconView2 {
    @try {
        if (!_vna) {
            _vna = [[ImGuiDrawView alloc] init];
        }
        
        [ImGuiDrawView showChange:NO];
        
        UIWindow *win = [UIApplication sharedApplication].keyWindow;
        if (win && win.rootViewController && win.rootViewController.view) {
            [win.rootViewController.view addSubview:_vna.view];
        }
    } @catch (NSException *e) {
        NSLog(@"Exception in tapIconView2: %@", e);
    }
}

- (void)tapIconView {
    @try {
        if (!_vna) {
            _vna = [[ImGuiDrawView alloc] init];
        }
        
        [ImGuiDrawView showChange:YES];
        
        UIWindow *win = [UIApplication sharedApplication].keyWindow;
        if (win && win.rootViewController && win.rootViewController.view) {
            [win.rootViewController.view addSubview:_vna.view];
        }
    } @catch (NSException *e) {
        NSLog(@"Exception in tapIconView: %@", e);
    }
}


- (void)setupDoxButton {
    dispatch_async(dispatch_get_main_queue(), ^{
        if (DoxButton) return;
        
        UIView *targetView = [UIApplication sharedApplication].keyWindow.rootViewController.view;
        if (!targetView) return;

        DoxButton = [UIButton buttonWithType:UIButtonTypeCustom];
        DoxButton.frame = CGRectMake([UIScreen mainScreen].bounds.size.width - 85 - 15, [UIScreen mainScreen].bounds.size.height * 0.3, 85, 40);
        DoxButton.layer.cornerRadius = DoxButton.frame.size.height / 2;
        DoxButton.clipsToBounds = NO;
        DoxButton.backgroundColor = [UIColor colorWithRed:0.0 green:0.0 blue:0.0 alpha:0.6];
        DoxButton.layer.borderWidth = 0;
        
        DoxButton.layer.shadowColor = [UIColor blackColor].CGColor;
        DoxButton.layer.shadowOffset = CGSizeMake(0, 2);
        DoxButton.layer.shadowOpacity = 0.5;
        DoxButton.layer.shadowRadius = 4;

        DoxIconView = [[UIImageView alloc] initWithFrame:CGRectMake(6, 5, 30, 30)];
        DoxIconView.contentMode = UIViewContentModeScaleAspectFill;
        DoxIconView.clipsToBounds = YES;
        DoxIconView.layer.cornerRadius = 15;
        DoxIconView.layer.borderWidth = 0;
        
        NSData *imageData = [[NSData alloc] initWithBase64EncodedString:asconfig options:0];
        if (imageData) {
            UIImage *originalImage = [UIImage imageWithData:imageData];
            if (originalImage) {
                UIGraphicsBeginImageContextWithOptions(DoxIconView.bounds.size, NO, 0.0);
                [[UIBezierPath bezierPathWithOvalInRect:DoxIconView.bounds] addClip];
                [originalImage drawInRect:DoxIconView.bounds];
                DoxIconView.image = UIGraphicsGetImageFromCurrentImageContext();
                UIGraphicsEndImageContext();
            }
        }
        [DoxButton addSubview:DoxIconView];
        
        DoxTextLabel = [[UILabel alloc] initWithFrame:CGRectMake(40, 0, 45, DoxButton.frame.size.height)];
        DoxTextLabel.text = @"ZOL";
        DoxTextLabel.textColor = [UIColor whiteColor];
        DoxTextLabel.font = [UIFont boldSystemFontOfSize:15];
        DoxTextLabel.textAlignment = NSTextAlignmentCenter;
        DoxTextLabel.adjustsFontSizeToFitWidth = YES;
        [DoxButton addSubview:DoxTextLabel];

        [DoxButton addTarget:self action:@selector(doxButtonDragged:withEvent:) forControlEvents:UIControlEventTouchDragInside];
        [DoxButton addTarget:self action:@selector(tapIconView) forControlEvents:UIControlEventTouchUpInside];
        
        [targetView addSubview:DoxButton];
    });
}

- (void)doxButtonDragged:(UIButton *)button withEvent:(UIEvent *)event {
    UITouch *touch = [[event touchesForView:button] anyObject];
    CGPoint previousLocation = [touch previousLocationInView:button];
    CGPoint location = [touch locationInView:button];
    CGFloat delta_x = location.x - previousLocation.x;
    CGFloat delta_y = location.y - previousLocation.y;
    button.center = CGPointMake(button.center.x + delta_x, button.center.y + delta_y);
}
@end